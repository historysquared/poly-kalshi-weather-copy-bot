[Unit]
Description=PredictionBots Polymarket US Weather Read-Only Collector
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=10

[Service]
Type=simple
WorkingDirectory=/opt/weather-alpha-releases/d013a3b1452af5a9cb64c9ee1ede6c3e4c50c44b
Environment=PYTHONPATH=/opt/weather-alpha-releases/d013a3b1452af5a9cb64c9ee1ede6c3e4c50c44b
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/weather-alpha-runtime/.venv/bin/python scripts/record_polymarket_us_weather.py --interval-seconds 60 --timeout 20 --raw-dir /data/weather/rolling30/polymarket_us/raw --current-output /data/weather/rolling30/polymarket_us/current.json --health-output /data/weather/rolling30/polymarket_us/health.json
Restart=always
RestartSec=5
KillSignal=SIGINT
TimeoutStopSec=30
SuccessExitStatus=130
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/data/weather/rolling30/polymarket_us
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
