[Unit]
Description=PredictionBots Kalshi Weather L2 Read-Only Archive Collector
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=root
WorkingDirectory=/opt/weather-alpha-releases/9fdf49a0797719e7ca4fccbae3cb12b3f94398b9
EnvironmentFile=/root/.config/weather-alpha/live.env
Environment=PYTHONPATH=/opt/weather-alpha-releases/9fdf49a0797719e7ca4fccbae3cb12b3f94398b9
ExecStartPre=/usr/bin/test -r /root/.kalshi/weather_ws_private_key.pem
ExecStart=/opt/weather-alpha-runtime/.venv/bin/python /opt/weather-alpha-releases/9fdf49a0797719e7ca4fccbae3cb12b3f94398b9/scripts/record_kalshi_weather_l2_archive.py --all-weather-catalog /data/weather/rolling30/kalshi/catalog.json --raw-dir /data/weather/rolling30/kalshi/raw --health-output /data/weather/rolling30/kalshi/health.json --ticker-cache /data/weather/rolling30/kalshi/ticker-cache.json --bbo-output /data/weather/rolling30/kalshi/bbo.json
Restart=always
RestartSec=5
TimeoutStopSec=20
KillSignal=SIGINT

[Install]
WantedBy=multi-user.target
